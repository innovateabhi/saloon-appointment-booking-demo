# ============================================================
# AURELIA — Environment Configuration
# ============================================================

APP_NAME="AURELIA — Luxury Salon & Beauty Studio"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/aurelia-salon/backend/public
FRONTEND_URL=http://localhost:5173

# Database (MySQL / MariaDB in XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aurelia_salon
DB_USERNAME=root
DB_PASSWORD=""
DB_CHARSET=utf8mb4

# Session & Security
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=false
SESSION_SAMESITE=Lax
APP_TIMEZONE="Asia/Kolkata"

# Mail (SMTP configuration)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="concierge@aurelia-salon.com"
MAIL_FROM_NAME="AURELIA Luxury Concierge"
MAIL_SIMULATE_LOCAL=true

# Business Defaults
DEFAULT_SALON_ID=1

