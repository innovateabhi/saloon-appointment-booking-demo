# ==============================================================================
# AURELIA — Production Environment Configuration (.env)
# Rename this file to .env in /var/www/aurelia-salon/backend/.env
# ==============================================================================

APP_NAME="AURELIA — Luxury Salon & Beauty Studio"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Database Connection (MySQL on EC2 localhost)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aurelia_salon
DB_USERNAME=aurelia_user
DB_PASSWORD=YourStrongDatabasePassword123!
DB_CHARSET=utf8mb4

# Session Security & Cookie Parameters
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Email Configuration (AWS SES, SendGrid, or Gmail SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=concierge@yourdomain.com
MAIL_FROM_NAME="AURELIA Salon Atelier"

# File Uploads Directory
UPLOAD_DIR=/var/www/aurelia-salon/backend/public/uploads
MAX_UPLOAD_SIZE=26214400 # 25 MB

